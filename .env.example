# Appwrite Configuration
# Obtén estos valores en https://cloud.appwrite.io/console -> Settings -> API Keys

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=tu-project-id-aqui
NEXT_PUBLIC_APPWRITE_DATABASE_ID=tu-database-id-aqui

# Opcional: Si tienes configurado API keys (solo para server-side)
# APPWRITE_API_KEY=tu-api-key-aqui